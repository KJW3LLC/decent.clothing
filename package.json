{
  "name": "decent-clothing",
  "version": "1.0.0",
  "description": "Clothing articles automatically generated and published on GitHub Pages",
  "main": "scripts/generate-guide.js",
  "scripts": {
    "generate": "node scripts/generate-guide.js",
    "check-links": "node scripts/check-links.js",
    "add-topic": "node scripts/add-topic.js",
    "show-tags": "node scripts/add-topic.js --tags",
    "add-images": "node scripts/add-images-retroactive.js",
    "fix-formatting": "node scripts/fix-guide-formatting.js",
    "fix-series": "node scripts/fix-series-metadata.js",
    "fix-links": "node scripts/fix-broken-links.js",
    "fix-series-nav": "node scripts/fix-series-navigation.js",
    "review": "node scripts/review-guides.js",
    "review:fix": "node scripts/review-guides.js --fix",
    "validate": "node scripts/validate-json.js",
    "validate:series": "node scripts/validate-series.js",
    "test:series": "node scripts/test-series-auto-update.js",
    "serve": "bundle exec jekyll serve --config _config.yml,_config_local.yml --host 127.0.0.1 --port 4000",
    "build:local": "bundle exec jekyll build --config _config.yml,_config_local.yml"
  },
  "keywords": [
    "clothing",
    "articles",
    "jekyll",
    "github-pages"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7"
  }
}
